#!/bin/bash
# Team Cymru taklidi: 151.80.x.x → AS16276 FR; başka her şey boş (PTR yok)
name="${!#}"
case "$name" in
  *.80.151.origin.asn.cymru.com) echo '"16276 | 151.80.0.0/16 | FR | ripencc | 2012-01-01"' ;;
  AS16276.asn.cymru.com)         echo '"16276 | FR | ripencc | 2001-01-01 | OVH, FR"' ;;
  *.113.0.203.origin.asn.cymru.com) [ -z "$NO_DNS" ] && echo '"64500 | 203.0.113.0/24 | US | arin | 2010-01-01"' ;;   # sunucunun kendi IP'si
  9.7.80.151.in-addr.arpa)       [ -n "$PTR_GOOGLE" ] && echo 'crawl-151-80-7-9.googlebot.com.' ;;   # csf.rignore sınaması
  crawl-151-80-7-9.googlebot.com) echo '151.80.7.9' ;;
  AS64500.asn.cymru.com)         echo '"64500 | US | arin | 2010-01-01 | EXAMPLE-HOSTING, US"' ;;
esac
exit 0
