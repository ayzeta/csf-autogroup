# ─────────────────────────────────────────────────────────────
# CSF Auto-Group — config. Copy to  config.env  next to the script.
# Every value is optional; the script uses sane defaults if absent.
# ─────────────────────────────────────────────────────────────

# Message / email language:  en | tr
MSG_LANG=en

# Where alert emails go.
ALERT_MAIL=root@localhost

# ── Thresholds ──────────────────────────────────────────────
# How many banned single IPs in a /24 trigger a permanent block:
THRESHOLD_24=3
# ...and at how many it also gets "do not delete":
THRESHOLD_24_PERMANENT=5
# /16 warn-only threshold (IPs across >=2 distinct /24s):
THRESHOLD_16=5
# Temp /24 grouping threshold:
THRESHOLD_TEMP_24=3
# Temp /16 warn-only threshold:
THRESHOLD_TEMP_16=5

# ── "Who is this?" info in alert emails ────────────────────
# 1 = show each IP's hostname (reverse DNS) and each block's owner
#     (ASN / organisation / country, via Team Cymru's free DNS service).
# 0 = no lookups (CC_IGNORE / CC_ALLOW / csf.rignore can't be checked then).
LOOKUP=1
# Seconds to wait for each DNS answer:
LOOKUP_TIMEOUT=2

# ── Paths (defaults are standard CSF locations) ─────────────
# DENY_FILE=/etc/csf/csf.deny
# CSF_CONF=/etc/csf/csf.conf
# CSF_BIN=/sbin/csf
# CSF_VAR=/var/lib/csf
# LOG_FILE=/var/log/csf_autogroup.log
# SAYAC_FILE=/var/lib/csf_autogroup/counter

# Housekeeping (SAYAC_RETENTION_DAYS = watch period for temp-banned /24s)
# The log is rotated by logrotate (/etc/logrotate.d/csf_autogroup, written from these two):
LOG_ROTATE_MB=1
LOG_ROTATE_KEEP=5
# Fallback only when logrotate is missing: keep the last N lines.
LOG_MAX_LINES=5000

# Old block bans: older than this many days count as "old" (filter in the plugin);
# with BLOCK_EXPIRE_AUTO=1 they are removed automatically on every run.
BLOCK_EXPIRE_DAYS=365
BLOCK_EXPIRE_AUTO=0
SAYAC_RETENTION_DAYS=180

# ── WHM plugin / --status ──────────────────────────────────
# How many days back "To review" looks:
# REVIEW_DAYS=7
# Event log the plugin reads (kept to EVENTS_MAX lines):
# EVENTS_FILE=/var/lib/csf_autogroup/events.jsonl
# EVENTS_MAX=5000
# lfd log read by the "Details" button on warnings older than the event log:
# LFD_LOG=/var/log/lfd.log
# Imunify360's own block list is re-read at most this often (minutes):
# IMUNIFY_REFRESH_MIN=60
