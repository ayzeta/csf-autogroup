# ─────────────────────────────────────────────────────────────
# CSF Auto-Group — config. Copy to  config.env  next to the script.
# Every value is optional; the script uses sane defaults if absent.
# ─────────────────────────────────────────────────────────────

# Message / email language:  en | tr
MSG_LANG=en

# Where alert emails go: whm = the contact address set in WHM (Basic WebHost Manager
# Setup, read at send time), or any email address. Without cPanel use an address.
ALERT_MAIL=whm

# ── Notification channels ──────────────────────────────────
# Which events go where (1 = on). Five kinds: firewall problem, list filling up, run notices
# (bans, suspicious ranges and networks, skips, old-block removal, lists that can't be downloaded),
# review records (REVIEW: violations from allowed / ignored / server IPs and open services, once per
# IP or range per day, not for muted items), weekly summary.
# Email: the HTML alert emails above. Slack: the Slack address set in WHM
# (/etc/wwwacct.conf.shadow, CONTACTSLACK), read at send time, never stored here.
IE_FIREWALL=1
IE_LISTFULL=1
IE_RUN=1
IE_REVIEW=1
IE_DIGEST=1
IC_FIREWALL=1
IC_LISTFULL=1
IC_RUN=1
IC_REVIEW=1
IC_DIGEST=1
# Legacy master switch (all | email | slack); the panel writes "all" and uses the per-event lines above.
NOTIFY=all
# Run notices go to Slack at most once per this many minutes (collected); urgent ones go right away.
# SLACK_BATCH_MIN=60

# Weekly summary: 1 = on, day 1 (Mon) … 7 (Sun); sent with the first run after 09:00.
DIGEST=1
DIGEST_DAY=1

# ── Thresholds ──────────────────────────────────────────────
# How many permanent single bans in a /24 (within PERM_WINDOW_DAYS) trigger a permanent block;
# singles whose service is already closed (provider, country, rented-server list, partial ban) don't trigger it:
THRESHOLD_24=3
# ...and at how many, counted when the block is banned, it also gets "do not delete" (a watched block always does):
THRESHOLD_24_PERMANENT=5
# Suspicious range (warn only): single bans (permanent and temp counted together)
# from >=2 distinct /24s inside one range its owner announces (/17-/23, from the
# owner cache). The suggestion is to ban that range instead of the /16:
THRESHOLD_PFX=4
# Suspicious network (/16, warn only): single bans of the same owner from >=2
# distinct sub-units (announced range, or /24 when unknown). Singles that all sit
# in one announced range report that range instead; owners are not added together:
THRESHOLD_16=5
# Temp /24 grouping threshold (temp single bans in a /24 at the same time; 12-hour temp block ban, permanent if
# it happens again while the block is watched):
THRESHOLD_TEMP_24=3
# (THRESHOLD_TEMP_16 is no longer used since 1.9.10: THRESHOLD_16 counts both lists.)

# ── "Who is this?" info in alert emails ────────────────────
# 1 = show each IP's hostname (reverse DNS) and each block's owner
#     (ASN / organisation / country, via Team Cymru's free DNS service).
# 0 = no lookups for new blocks (cached owners are still used; suspicious range / network counts go by owner).
#     CC_IGNORE / CC_ALLOW / csf.rignore can't be checked then, so blocks they would protect are banned too.
LOOKUP=1
# Seconds to wait for each DNS answer:
LOOKUP_TIMEOUT=2

# ── Paths (defaults are standard CSF locations) ─────────────
# DENY_FILE=/etc/csf/csf.deny
# CSF_CONF=/etc/csf/csf.conf
# CSF_BIN=/sbin/csf
# CSF_VAR=/var/lib/csf
# LOG_FILE=/var/log/csf_autogroup.log
# SAYAC_FILE=/var/lib/csf_autogroup/counter

# Housekeeping (SAYAC_RETENTION_DAYS = watch period for /24s that got a temp block ban or whose permanent ban
# was removed outside the plugin)
# The log is rotated by logrotate (/etc/logrotate.d/csf_autogroup, written from these two):
LOG_ROTATE_MB=1
LOG_ROTATE_KEEP=5
# Fallback only when logrotate is missing: log lines older than this many days are removed.
LOG_KEEP_DAYS=30
# Event log (History tab, settings history, the violations behind each ban): kept this many days;
# records of range bans still in place and of watched blocks are kept longer.
# Run records (one per run: duration, list usage) are kept separately; at least 31 days: the 30-day
# chart and the weekly summary's run count read them (the summary cards compare with 7 days ago).
EVENTS_DAYS=180
RUN_DAYS=31
# Permanent single bans older than this (by their date in csf.deny) do not count toward
# the block / network thresholds or the provider ranking (they stay banned in CSF).
PERM_WINDOW_DAYS=90
# Ban history (every single ban with when / how long / why), kept this many days after
# the ban ends; at least PERM_WINDOW_DAYS.
BANLOG_DAYS=90

# Old block bans: automatic block bans older than this many days count as "old" (filter in the plugin),
# except ones marked "do not delete" and ones tried within BLOCK_ACTIVE_DAYS;
# with BLOCK_EXPIRE_AUTO=1 they are removed automatically on every run.
BLOCK_EXPIRE_DAYS=365
BLOCK_EXPIRE_AUTO=0
SAYAC_RETENTION_DAYS=180

# ── WHM plugin / --status ──────────────────────────────────
# How many days back "Needs review" looks:
# REVIEW_DAYS=7
# Event log the plugin reads (kept for EVENTS_DAYS / RUN_DAYS, see above):
# EVENTS_FILE=/var/lib/csf_autogroup/events.jsonl
# Imunify360's block list and whitelist are re-read at most this often (minutes; the whitelist keeps
# a block that holds a whitelisted IP from being banned):
# IMUNIFY_REFRESH_MIN=60
# Manual bans: where the entries removed by "Remove covered entries" are kept
# (restorable when the ban is lifted), and where SSH / FTP settings are read:
# RESTORE_DIR=/var/lib/csf_autogroup/restore
# SSHD_CONFIG=/etc/ssh/sshd_config
# PUREFTPD_CONF=/etc/pure-ftpd.conf
# PROFTPD_CONF=/etc/proftpd.conf

# ENABLED=1                 # 0 = paused: no new bans or notifications; provider ban, rented-server ban, block counter
#                           # and ban guard removed until turned back on (block and single bans stay)
# ── Provider ban (experimental; Settings → Provider ban) ───
# Left unset, both follow what is already in CSF (a provider ban or the allowed
# services file set up by hand is adopted).
# ASN_BAN=0                 # 1 = ban the providers in ASN_LIST
# ASN_LIST=AS396982         # banned with the shared port list, comma separated (at most 50)
# ASN_ALL=                  # everything blocked (CC_DENY), comma separated (at most 50)
# ASN_MODE=web              # shared port list: web (TCP 80,443 + UDP 443) | ports (all: older setting, every provider on everything)
# ASN_TCP=80,443            # ASN_MODE=ports
# ASN_UDP=443
# SVC_ALLOW=0               # 1 = write published service addresses to csf.allow
# SVC_SOURCES=google        # google bing apple duckduckgo openai stripe mollie uptimerobot pingdom statuscake microsoft365 quiccloud
# SVC_EXTRA="office|203.0.113.10 pay|https://example.com/ips.txt"
# SVC_URLS="bing|https://example.com/bingbot.json"   # replaces a built-in source's address (name|address)
# SVC_SKIP=openai-gptbot    # sub-lists left out, comma separated: google-common google-special google-user google-user-google openai-gptbot openai-search openai-user
# SVC_EXCEPT="203.0.113.7 198.51.100.0/24"   # never allowed even when a service list contains them (IPv4 or /8–/32, space separated)
# CLOUD_BAN=0               # 1 = block the customer address lists cloud providers publish (tools/cloud-ban.sh)
# CLOUD_SOURCES=gcp         # gcp aws azure oracle digitalocean linode vultr
# CLOUD_MODES=              # per list, what to block (the panel writes it): "name=mode:services:ports", space separated
#                           # mode svc = the services / ports given · all = everything · exc = everything except them
#                           # services: web ssh ftp cp smtp mread dns (min, sync: older entries); ports: 8080,30000-35000,443/udp
#                           # (at most 15); own lists are named x-<name>
#                           # e.g. "aws=exc:web: azure=svc:web,ssh:"  (only new connections to this server are blocked)
# CLOUD_TCP=80,443          # lists without a CLOUD_MODES entry block these ports (the former shared setting)
# CLOUD_UDP=443
# CLOUD_URLS=               # replaces a list's address: "gcp|https://…"
# CLOUD_EXTRA=              # your own lists: "name|https://url[|filter[|link]]", at most 50; "box--source|…" adds a source to a box
#                           # filter: "j:field=value&…" (JSON, values %-encoded) or "t:text" (lines), "-" = none; link: pattern on a page (* = anything)
#                           # e.g. "aws2--eu|https://ip-ranges.amazonaws.com/ip-ranges.json|j:service=EC2&region=eu-north-1"

# Refresh and timing (all also set from the panel; defaults shown)
# CLOUD_REFRESH_DAYS=1        # rented-server lists are downloaded again this often (days)
# CLOUD_FAIL_DAYS=3           # a rented-server list failing this many days is reported
# SVC_REFRESH_DAYS=1          # allowed-service lists are downloaded again this often (days)
# SVC_FAIL_DAYS=3             # an allowed-service list failing this many days is reported
# REFRESH_HOUR=4              # the lists above and the CDN site check are refreshed in the first run after this hour
#                             # (0–23, server time); "off" = exactly the set number of days after the last refresh
#                             # (the CDN site check every 23 hours)
# GEO_REFRESH_DAYS=25         # CSF's ASN data (ip2asn) older than this is downloaded again by lfd (only while CSF has
#                             # a provider ban; lfd is restarted for it)
# OWNER_TTL_DAYS=30           # a block's owner (ASN, country, announced range) is looked up again after this (a limited
#                             # number of blocks per run; the old info is used until then)
# IMUNIFY_REFRESH_MIN=60      # Imunify360's block list and whitelist are read again this often (minutes)
# BLOCK_ACTIVE_DAYS=30        # a banned block with an attempt within this time is not "old"
